# MUNSIT AI — environment variables
# Copy to .env.local for local development. Never commit real values.
#
# Only NEXT_PUBLIC_* variables are read by the frontend configuration
# (src/config/env.ts). Anything prefixed NEXT_PUBLIC_ is shipped to the
# browser, so it must never contain a secret, token or key.

# Deployment stage label: development | test | production
NEXT_PUBLIC_APP_ENV=development
