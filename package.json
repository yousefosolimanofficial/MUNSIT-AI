{
  "name": "munsit-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MUNSIT AI — frontend application (Next.js App Router, TypeScript strict).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && eslint . && depcruise src --config .dependency-cruiser.cjs && prettier . --check && vitest run && next build"
  },
  "dependencies": {
    "next": "^16.4.6",
    "next-intl": "4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
